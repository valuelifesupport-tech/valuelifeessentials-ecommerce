# Application Configuration
PORT=5000

# Database Configuration (Hostinger MySQL or Local SQLite)
# Set DB_TYPE=mysql to use Hostinger Free MySQL Database. Leave blank or set DB_TYPE=sqlite for local SQLite.
DB_TYPE=sqlite

# Hostinger Free MySQL Credentials (Required only when DB_TYPE=mysql)
MYSQL_HOST=localhost
MYSQL_USER=u123456789_dbname
MYSQL_PASSWORD=YourStrongDatabasePassword123!
MYSQL_DATABASE=u123456789_dbname
MYSQL_PORT=3306
